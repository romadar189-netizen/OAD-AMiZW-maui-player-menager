            <BoxView HeightRequest="1" Margin="0,8" Color="Gray" />
            <Label Text="Edytuj gracza" FontSize="22" FontAttributes="Bold" />
            <Entry Placeholder="ID gracza" Keyboard="Numeric" Text="{Binding EditPlayerId}" />
            <Entry Placeholder="Nowa nazwa" Text="{Binding EditPlayerName}" />
            <Entry Placeholder="Nowy poziom" Keyboard="Numeric" Text="{Binding EditPlayerLevel}" />
            <Button Text="Edytuj gracza" Command="{Binding EditPlayerCommandButton}" />

            <Label Text="{Binding OperationResult}" FontSize="16"
                   FontAttributes="Bold" Margin="0,8,0,20" />
        </VerticalStackLayout>
    </ScrollView>
